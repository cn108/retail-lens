# Copy to .env and adjust. Never commit .env.
# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=retaillens
POSTGRES_USER=retaillens
POSTGRES_PASSWORD=retaillens
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Sessions (M2) ---
# The dev server proxies /api, so these only matter if the proxy is bypassed.
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SESSION_COOKIE_AGE=1209600

# --- Limits ---
MAX_UPLOAD_BYTES=52428800

# --- Email (scheduled report delivery) ---
# Defaults to the console backend, which prints messages to the container log.
# Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to send for real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=retail-lens@example.com
